{
  "compilerOptions": {
    /* Base Options */
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    // For `process.env.NODE_ENV`, which bundlers replace (development
    // warnings): the declarations emitted don't use it.
    "types": ["node"],
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Strictness */
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* Output */
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
